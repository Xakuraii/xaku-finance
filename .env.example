# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database (Docker maps host 55432 to container 5432)
DATABASE_URL=postgres://xaku:xaku_dev_password@127.0.0.1:55432/xaku

# Cache / queue
REDIS_URL=redis://127.0.0.1:56379/0

# Auth
JWT_SIGNING_KEY=replace-with-another-long-random-string
IP_HASH_KEY=replace-with-a-third-long-random-string
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Browser origins, comma separated. Never a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Email. Local settings use the console backend by default.
# To send through Mailpit (`docker compose up -d mailpit`), uncomment these:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=56380
DEFAULT_FROM_EMAIL="XakuFinance <no-reply@xakufinance.local>"

# Optional integrations (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
